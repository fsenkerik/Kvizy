# Postgres (Neon) – na Vercelu se nastaví automaticky po přidání Neon databáze.
# Když proměnná chybí nebo nezačíná postgres://, použije se lokální PGlite ve složce .pglite.
DATABASE_URL=

# Tajný klíč pro podepisování přihlašovacích cookies (min. 16 znaků, ideálně 32+ náhodných).
# Vygeneruj např.: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Veřejná adresa aplikace – tiskne se na kartičky s PINy (volitelné).
NEXT_PUBLIC_APP_URL=
